#!/usr/bin/env bash
# ==============================================================================
# coffee-piaacmc - Unified CLI for PIAACMC & APLCMC Coronagraph Design
# ==============================================================================

set -euo pipefail

CONF_FILE="piaacmc.conf"
CONF_DIR="conf"
SYNC_STAMP="${CONF_DIR}/.synced"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_BOLD=$'\033[1m'
    C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'
    C_RED=$'\033[1;31m'
    C_CYAN=$'\033[1;36m'
    C_RESET=$'\033[0m'
else
    C_BOLD=""
    C_GREEN=""
    C_YELLOW=""
    C_RED=""
    C_CYAN=""
    C_RESET=""
fi

log_ok()   { printf "[%s  OK  %s] %s\n" "${C_GREEN}" "${C_RESET}" "$*"; }
log_warn() { printf "[%s WARN %s] %s\n" "${C_YELLOW}" "${C_RESET}" "$*"; }
log_err()  { printf "[%s FAIL %s] %s\n" "${C_RED}" "${C_RESET}" "$*" >&2; }
log_info() { printf "%s==>%s %s\n" "${C_CYAN}" "${C_RESET}" "$*"; }

# Schema entries: "section|key|default|unit|description"
CONF_SCHEMA=(
    "Optical System|PIAAmode|1|flag|1: PIAACMC (with PIAA optics), 0: APLCMC"
    "Optical System|size|1024|pix|2D wavefront numerical grid size"
    "Optical System|beamrad|0.01|m|Physical beam radius in simulation space"
    "Optical System|pscale|0.00005|m/pix|Pupil plane pixel scale"
    "Optical System|Fratio|80.0|ratio|Focal ratio at focal plane mask"
    "Optical System|lambda|550|nm|Central design wavelength"
    "Optical System|mlambdaB|10|%|Polychromatic spectral bandwidth"
    "Optical System|nblambda|10|count|Number of discrete spectral channels"
    "Pupil & PIAA|coin|0.30|beamrad|Input pupil central obscuration ratio"
    "Pupil & PIAA|coout|0.20|beamrad|Remapped output central obscuration ratio"
    "Pupil & PIAA|pupoutmaskrad|0.95|beamrad|Output pupil stop radius ratio"
    "Pupil & PIAA|PIAAmaterial|Mirror|material|PIAA optics material (Mirror, SiO2, CaF2)"
    "Pupil & PIAA|invPIAAmode|0|flag|0: no inverse PIAA, 1: inverse PIAA enabled"
    "Pupil & PIAA|PIAAcirc|0|flag|0: 2D Cosine+Fourier, 1: circular Cosine only"
    "Pupil & PIAA|PIAA0pos|0.0|m|PIAA element 0 axial conjugation from pupil"
    "Pupil & PIAA|PIAAsep|1.00|m|Axial separation between PIAA elements 0 and 1"
    "Pupil & PIAA|PIAAr0lim|1.15|beamrad|Outer radius limit of PIAA element 0"
    "Pupil & PIAA|PIAAr1lim|1.50|beamrad|Outer radius limit of PIAA element 1"
    "Pupil & PIAA|prePIAA0maskpos|0.0|m|Pre-PIAA0 amplitude mask conjugation"
    "Pupil & PIAA|postPIAA0maskpos|0.0|m|Post-PIAA0 amplitude mask conjugation"
    "Pupil & PIAA|piaaNBCmodesmax|40|modes|Max radial cosine modes for PIAA sag fit"
    "Pupil & PIAA|piaaCPAmax|10.0|CPA|Max cycles/aperture for 2D Fourier PIAA fit"
    "Lyot Stops|NBls|3|count|Number of Lyot stop masks"
    "Lyot Stops|LStransm|0.85|0..1|Target geometric Lyot stop throughput"
    "Lyot Stops|LyotZmin|-1.5|m|Minimum Lyot stop conjugation search bound"
    "Lyot Stops|LyotZmax|1.5|m|Maximum Lyot stop conjugation search bound"
    "Focal Plane Mask|fpmmaterial|Mirror|material|FPM material (Mirror, SiO2, CaF2, CstPha)"
    "Focal Plane Mask|fpmradld|1.00|l/D|Idealized monochromatic FPM radius"
    "Focal Plane Mask|maskradld|2.00|l/D|Physical multi-zone FPM outer radius"
    "Focal Plane Mask|NBrings|16|rings|Number of concentric hexagonal FPM rings"
    "Focal Plane Mask|FPMsectors|2|mode|0: rings, 1: full hex, 2: 60-deg sectors"
    "Focal Plane Mask|fpmminsag|-1.0e-6|m|Minimum allowed FPM zone sag"
    "Focal Plane Mask|fpmmaxsag|1.0e-6|m|Maximum allowed FPM zone sag"
    "Focal Plane Mask|fpmregsag_coeff|1.0|weight|FPM sag regularization weight"
    "Focal Plane Mask|fpmregsag_alpha|1.0|exp|FPM sag regularization exponent"
    "Focal Plane Mask|fpmccnbr|0|rings|Inner rings in FPM central cone"
    "Focal Plane Mask|fpmccz|0.0|m|FPM central cone peak sag"
    "Focal Plane Mask|fpmocradld|0.0|l/D|FPM outer cone outer radius (0 disables)"
    "Focal Plane Mask|fpmocz|0.0|m|FPM outer cone sag amplitude"
    "Focal Plane Mask|ssize|10|0.1mas|Stellar angular diameter (10 = 1.0 mas)"
    "Focal Plane Mask|extmode|0|mode|Extended source model (0: 3-pt, 1: 6-pt)"
    "Optimization|NBthreads|4|procs|Parallel workers for polychromatic FPM calib"
    "Optimization|searchtime|600|s|Time budget per multi-zone FPM search pass"
    "Optimization|NBpropStep|200|planes|Fresnel planes in Lyot conjugation search"
    "Optimization|nbiterSA|10000|iter|Simulated annealing steps per FPM pass"
    "Optimization|nbiterDS|100|iter|Downhill simplex steps per FPM pass"
    "Optimization|REGPIAACCOEFF|300.0|weight|PIAA cosine mode regularization weight"
    "Optimization|REGPIAACALPHA|0.25|exp|PIAA cosine mode regularization exponent"
    "Optimization|REGPIAAFCOEFF|300.0|weight|PIAA Fourier mode regularization weight"
    "Optimization|REGPIAAFALPHA|0.25|exp|PIAA Fourier mode regularization exponent"
)

VALID_MATERIALS=(
    Mirror SiO2 Si PMGI PMMA N2 O2 Ar He H2 H2Og H2O CO2 Ne O CaF2 Vacuum Air CstPha
)

print_usage() {
    cat <<EOF
${C_BOLD}coffee-piaacmc${C_RESET} - Unified PIAACMC & APLCMC Coronagraph Design CLI

${C_BOLD}USAGE:${C_RESET}
  coffee-piaacmc <command> [options]

${C_BOLD}COMMANDS:${C_RESET}
  init      Initialize a design workspace (pupil, conf/, and piaacmc.conf)
  config    Inspect, modify, synchronize, or validate piaacmc.conf
  status    Show design step progress, calibration state, and contrast metrics
  run       Execute monochromatic and/or polychromatic coronagraph optimization
  eval      Evaluate on-axis/off-axis polychromatic PSFs and contrast curves
  quantize  Quantize continuous FPM zone sags to N lithographic etch steps
  clean     Remove simulation outputs (or full workspace with --all)

${C_BOLD}COMMON WORKFLOW:${C_RESET}
  coffee-piaacmc init --example 1
  coffee-piaacmc config set mlambdaB=10 nblambda=8 NBthreads=4
  coffee-piaacmc run --mono
  coffee-piaacmc run --poly --jobs 4 --search-time 300
  coffee-piaacmc eval --level 0
  coffee-piaacmc status

Run 'coffee-piaacmc <command> --help' for command-specific options.
EOF
}

read_conf_key() {
    local key="$1"
    local def="${2:-}"
    local f="${CONF_DIR}/conf_${key}.txt"
    if [ -f "$f" ]; then
        head -n 1 "$f" | tr -d ' \t\r\n'
    else
        printf "%s" "$def"
    fi
}

write_conf_key() {
    local key="$1"
    local val="$2"
    mkdir -p "${CONF_DIR}"
    printf "%s\n" "$val" > "${CONF_DIR}/conf_${key}.txt"
    case "$key" in
        lambda)
            printf "%s\n" "$val" > "${CONF_DIR}/conf_mlambda.txt"
            ;;
        PIAAr0lim)
            printf "%s\n" "$val" > "${CONF_DIR}/conf_r0lim.txt"
            ;;
        PIAAr1lim)
            printf "%s\n" "$val" > "${CONF_DIR}/conf_r1lim.txt"
            ;;
        PIAAmaterial)
            printf "%s\n" "$val" > "${CONF_DIR}/conf_PIAAmaterial_name.txt"
            ;;
        fpmmaterial)
            printf "%s\n" "$val" > "${CONF_DIR}/conf_fpmmaterial_name.txt"
            ;;
    esac
}

sync_aliases_in_confdir() {
    mkdir -p "${CONF_DIR}"
    if [ -f "${CONF_DIR}/conf_lambda.txt" ] && [ ! -f "${CONF_DIR}/conf_mlambda.txt" ]; then
        cp "${CONF_DIR}/conf_lambda.txt" "${CONF_DIR}/conf_mlambda.txt"
    fi
    if [ -f "${CONF_DIR}/conf_r0lim.txt" ] && [ ! -f "${CONF_DIR}/conf_PIAAr0lim.txt" ]; then
        cp "${CONF_DIR}/conf_r0lim.txt" "${CONF_DIR}/conf_PIAAr0lim.txt"
    fi
    if [ -f "${CONF_DIR}/conf_PIAAr0lim.txt" ]; then
        cp "${CONF_DIR}/conf_PIAAr0lim.txt" "${CONF_DIR}/conf_r0lim.txt"
    fi
    if [ -f "${CONF_DIR}/conf_r1lim.txt" ] && [ ! -f "${CONF_DIR}/conf_PIAAr1lim.txt" ]; then
        cp "${CONF_DIR}/conf_r1lim.txt" "${CONF_DIR}/conf_PIAAr1lim.txt"
    fi
    if [ -f "${CONF_DIR}/conf_PIAAr1lim.txt" ]; then
        cp "${CONF_DIR}/conf_PIAAr1lim.txt" "${CONF_DIR}/conf_r1lim.txt"
    fi
    if [ -f "${CONF_DIR}/conf_PIAAmaterial.txt" ]; then
        cp "${CONF_DIR}/conf_PIAAmaterial.txt" "${CONF_DIR}/conf_PIAAmaterial_name.txt"
    fi
    if [ -f "${CONF_DIR}/conf_fpmmaterial.txt" ]; then
        cp "${CONF_DIR}/conf_fpmmaterial.txt" "${CONF_DIR}/conf_fpmmaterial_name.txt"
    fi
}

write_piaacmc_conf_from_dir() {
    mkdir -p "${CONF_DIR}"
    sync_aliases_in_confdir
    local cur_sec=""
    {
        echo "# ============================================================================"
        echo "# piaacmc.conf - PIAACMC / APLCMC Coronagraph Design Configuration"
        echo "# Edit values here or via 'coffee-piaacmc config set KEY=VALUE'."
        echo "# Automatically synchronized with ./conf/conf_<key>.txt."
        echo "# ============================================================================"
        for entry in "${CONF_SCHEMA[@]}"; do
            IFS='|' read -r sec key def unit desc <<< "$entry"
            if [ "$sec" != "$cur_sec" ]; then
                echo ""
                echo "# --- ${sec} ---"
                cur_sec="$sec"
            fi
            local val
            val=$(read_conf_key "$key" "$def")
            write_conf_key "$key" "$val"
            printf "%-20s = %-16s # [%s] %s\n" "$key" "$val" "$unit" "$desc"
        done
    } > "${CONF_FILE}"
    cksum "${CONF_FILE}" > "${SYNC_STAMP}"
}

parse_piaacmc_conf_to_dir() {
    if [ ! -f "${CONF_FILE}" ]; then
        log_err "File ${CONF_FILE} not found."
        return 1
    fi
    mkdir -p "${CONF_DIR}"
    while IFS= read -r rawline || [ -n "$rawline" ]; do
        local line="${rawline%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [ -z "$line" ] && continue
        if [[ "$line" =~ ^([A-Za-z0-9_]+)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            local k="${BASH_REMATCH[1]}"
            local v="${BASH_REMATCH[2]}"
            v="${v%"${v##*[![:space:]]}"}"
            v="${v#\"}"
            v="${v%\"}"
            write_conf_key "$k" "$v"
        else
            log_warn "Ignoring malformed line in ${CONF_FILE}: ${rawline}"
        fi
    done < "${CONF_FILE}"
    sync_aliases_in_confdir
    cksum "${CONF_FILE}" > "${SYNC_STAMP}"
}

auto_sync_config() {
    if [ -f "${CONF_FILE}" ]; then
        local cur_sum old_sum=""
        cur_sum=$(cksum "${CONF_FILE}")
        [ -f "${SYNC_STAMP}" ] && old_sum=$(cat "${SYNC_STAMP}")
        if [ "$cur_sum" != "$old_sum" ]; then
            parse_piaacmc_conf_to_dir
        fi
    elif [ -d "${CONF_DIR}" ]; then
        write_piaacmc_conf_from_dir
    fi
}

is_valid_material() {
    local mat="$1"
    for m in "${VALID_MATERIALS[@]}"; do
        if [ "$m" = "$mat" ]; then
            return 0
        fi
    done
    return 1
}

validate_config() {
    local quiet="${1:-0}"
    local errs=0

    if [ ! -d "${CONF_DIR}" ] && [ ! -f "${CONF_FILE}" ]; then
        log_err "No configuration found. Run 'coffee-piaacmc init' first."
        return 1
    fi
    auto_sync_config

    local size beamrad pscale lambda mlambdaB nblambda nbrings lstransm piaamat fpmmat
    size=$(read_conf_key "size" "0")
    beamrad=$(read_conf_key "beamrad" "0")
    pscale=$(read_conf_key "pscale" "0")
    lambda=$(read_conf_key "lambda" "0")
    mlambdaB=$(read_conf_key "mlambdaB" "0")
    nblambda=$(read_conf_key "nblambda" "0")
    nbrings=$(read_conf_key "NBrings" "0")
    lstransm=$(read_conf_key "LStransm" "0")
    piaamat=$(read_conf_key "PIAAmaterial" "Mirror")
    fpmmat=$(read_conf_key "fpmmaterial" "Mirror")

    if ! [[ "$size" =~ ^[0-9]+$ ]] || [ "$size" -lt 64 ]; then
        log_err "Invalid grid size=${size} (expected integer >= 64)."
        errs=$((errs + 1))
    elif [ ! -f "pup_${size}.fits" ]; then
        log_err "Pupil FITS file pup_${size}.fits not found in working directory."
        errs=$((errs + 1))
    elif [ "$quiet" -eq 0 ]; then
        log_ok "Pupil file pup_${size}.fits present (grid ${size}x${size})"
    fi

    local geom_check
    geom_check=$(awk -v b="$beamrad" -v p="$pscale" -v s="$size" 'BEGIN {
        if (b <= 0 || p <= 0 || s <= 0) { print "BAD 0 0"; exit }
        dpix = 2.0 * b / p
        fill = dpix / s
        if (dpix >= s) printf "OVERFLOW %.1f %.3f\n", dpix, fill
        else printf "OK %.1f %.3f\n", dpix, fill
    }')
    local gstatus gdpix gfill
    read -r gstatus gdpix gfill <<< "$geom_check"
    if [ "$gstatus" != "OK" ]; then
        log_err "Beam diameter (${gdpix} pix) exceeds grid size (${size} pix)."
        errs=$((errs + 1))
    elif [ "$quiet" -eq 0 ]; then
        log_ok "Beam diameter ${gdpix} pix fits in ${size} pix grid (fill=${gfill})"
    fi

    if ! is_valid_material "$piaamat"; then
        log_err "Unsupported PIAAmaterial='${piaamat}'."
        errs=$((errs + 1))
    elif [ "$quiet" -eq 0 ]; then
        log_ok "PIAAmaterial='${piaamat}' recognized"
    fi

    if ! is_valid_material "$fpmmat"; then
        log_err "Unsupported fpmmaterial='${fpmmat}'."
        errs=$((errs + 1))
    elif [ "$quiet" -eq 0 ]; then
        log_ok "fpmmaterial='${fpmmat}' recognized"
    fi

    local wave_ok
    wave_ok=$(awk -v l="$lambda" -v b="$mlambdaB" -v n="$nblambda" -v r="$nbrings" \
        -v lt="$lstransm" 'BEGIN {
        if (l <= 0 || b < 0 || n < 1 || r < 1 || lt <= 0 || lt > 1.0) print 0
        else print 1
    }')
    if [ "$wave_ok" != "1" ]; then
        log_err "Invalid spectral/mask bounds (lambda=${lambda}, bw=${mlambdaB}%," \
            "nblambda=${nblambda}, NBrings=${nbrings}, LStransm=${lstransm})."
        errs=$((errs + 1))
    elif [ "$quiet" -eq 0 ]; then
        log_ok "Spectral & mask parameters valid (${lambda} nm, ${mlambdaB}% bw," \
            "${nblambda} ch, ${nbrings} rings)"
    fi

    [ "$errs" -eq 0 ]
}

resolve_examples_dir() {
    local script_dir
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    local cand
    for cand in \
        "./examples" \
        "${script_dir}/../examples" \
        "${script_dir}/../share/coffee/PIAACMCsimul/examples" \
        "/home/oguyon/src/coffee/PIAACMCsimul/examples"; do
        if [ -d "$cand" ]; then
            (cd "$cand" && pwd)
            return 0
        fi
    done
    return 1
}

cmd_init() {
    local example="1"
    local preset=""
    local aplc=0
    local force=0

    while [ $# -gt 0 ]; do
        case "$1" in
            -e|--example)
                example="$2"
                shift 2
                ;;
            --speed)
                preset="setup_SPEED"
                shift
                ;;
            --speed1024)
                preset="setup_SPEED1024"
                shift
                ;;
            --speed1024-noinv)
                preset="setup_SPEED1024_noinvPIAA"
                shift
                ;;
            -a|--aplc)
                aplc=1
                shift
                ;;
            -f|--force)
                force=1
                shift
                ;;
            -h|--help)
                cat <<EOF
${C_BOLD}USAGE:${C_RESET} coffee-piaacmc init [options]

${C_BOLD}OPTIONS:${C_RESET}
  -e, --example <0..7>   Initialize built-in design example (default: 1)
                           0: Subaru PIAACMC, H-band, 2048 grid, SiO2 lenses
                           1: WFIRST/Roman PIAACMC, visible, 1024 grid, mirrors
                           2: 3-ring segmented aperture PIAACMC, visible, 1024
                           3: LUVOIR 1024 grid, 1300 nm PIAACMC
                           4: LUVOIR 2048 grid, 1300 nm PIAACMC
                           5: Subaru SCExAO APLCMC, H-band, 1024 grid
                           6: Clear circular pupil APLCMC, H-band, 1024 grid
                           7: MagAO-X PIAACMC, 1024 grid, SiO2 FPM
      --speed            Initialize SPEED 2048 PIAACMC preset
      --speed1024        Initialize SPEED 1024 PIAACMC preset
      --speed1024-noinv  Initialize SPEED 1024 preset without inverse PIAA
  -a, --aplc             Configure APLCMC mode (disable PIAA optics)
  -f, --force            Overwrite existing piaacmc.conf / conf/ directory
EOF
                return 0
                ;;
            *)
                log_err "Unknown init option: $1"
                return 1
                ;;
        esac
    done

    if [ "$force" -eq 0 ] && { [ -f "${CONF_FILE}" ] || [ -d "${CONF_DIR}" ]; }; then
        log_err "Workspace already contains ${CONF_FILE} or ${CONF_DIR}/." \
            "Use --force to reinitialize."
        return 1
    fi

    rm -f "${CONF_FILE}" "${SYNC_STAMP}"
    mkdir -p "${CONF_DIR}" log

    if [ -n "$preset" ]; then
        local exdir
        if ! exdir=$(resolve_examples_dir); then
            log_err "Could not locate PIAACMCsimul/examples directory."
            return 1
        fi
        log_info "Initializing preset ${preset} from ${exdir}..."
        bash "${exdir}/${preset}"
    else
        log_info "Initializing design example ${example}..."
        coffee-runPIAACMCdesign -e "${example}" -l >/dev/null
    fi

    if [ "$aplc" -eq 1 ]; then
        coffee-runPIAACMCdesign -a >/dev/null
    fi

    write_piaacmc_conf_from_dir
    log_ok "Wrote ${CONF_FILE} and synchronized ${CONF_DIR}/"
    validate_config 0
}

cmd_config() {
    local sub="${1:-show}"
    [ $# -gt 0 ] && shift || true

    case "$sub" in
        show)
            validate_config 1
            local cur_sec=""
            for entry in "${CONF_SCHEMA[@]}"; do
                IFS='|' read -r sec key def unit desc <<< "$entry"
                if [ "$sec" != "$cur_sec" ]; then
                    printf "\n${C_BOLD}[%s]${C_RESET}\n" "$sec"
                    cur_sec="$sec"
                fi
                local val
                val=$(read_conf_key "$key" "$def")
                printf "  %-20s = %-14s %-10s %s\n" "$key" "$val" "[${unit}]" "$desc"
            done
            echo ""
            ;;
        set)
            if [ $# -eq 0 ]; then
                log_err "Usage: coffee-piaacmc config set KEY=VALUE [KEY2=VALUE2 ...]"
                return 1
            fi
            auto_sync_config
            for pair in "$@"; do
                if [[ "$pair" =~ ^([A-Za-z0-9_]+)=(.*)$ ]]; then
                    local k="${BASH_REMATCH[1]}"
                    local v="${BASH_REMATCH[2]}"
                    write_conf_key "$k" "$v"
                    log_ok "Set ${k} = ${v}"
                else
                    log_err "Invalid assignment '${pair}' (expected KEY=VALUE)."
                    return 1
                fi
            done
            write_piaacmc_conf_from_dir
            validate_config 0
            ;;
        sync)
            if [ "${1:-}" = "--from-conf" ]; then
                write_piaacmc_conf_from_dir
                log_ok "Regenerated ${CONF_FILE} from ${CONF_DIR}/conf_*.txt"
            elif [ -f "${CONF_FILE}" ]; then
                parse_piaacmc_conf_to_dir
                write_piaacmc_conf_from_dir
                log_ok "Synchronized ${CONF_FILE} <-> ${CONF_DIR}/conf_*.txt"
            elif [ -d "${CONF_DIR}" ]; then
                write_piaacmc_conf_from_dir
                log_ok "Generated ${CONF_FILE} from ${CONF_DIR}/conf_*.txt"
            else
                log_err "Neither ${CONF_FILE} nor ${CONF_DIR}/ found."
                return 1
            fi
            ;;
        check)
            validate_config 0
            ;;
        -h|--help)
            cat <<EOF
${C_BOLD}USAGE:${C_RESET}
  coffee-piaacmc config [show]
  coffee-piaacmc config set KEY=VALUE [KEY2=VALUE2 ...]
  coffee-piaacmc config sync [--from-conf]
  coffee-piaacmc config check
EOF
            ;;
        *)
            log_err "Unknown config action: ${sub}"
            return 1
            ;;
    esac
}

cmd_status() {
    if [ ! -d "${CONF_DIR}" ] && [ ! -f "${CONF_FILE}" ]; then
        log_warn "No PIAACMC configuration in $(pwd). Run 'coffee-piaacmc init'."
        return 0
    fi
    auto_sync_config

    local mode_val mode_str size lam bw nch nbrings
    mode_val=$(read_conf_key "PIAAmode" "1")
    [ "$mode_val" = "1" ] && mode_str="PIAACMC (PIAA enabled)" || mode_str="APLCMC (no PIAA)"
    size=$(read_conf_key "size" "?")
    lam=$(read_conf_key "lambda" "?")
    bw=$(read_conf_key "mlambdaB" "?")
    nch=$(read_conf_key "nblambda" "?")
    nbrings=$(read_conf_key "NBrings" "?")

    printf "${C_BOLD}Design Summary:${C_RESET}\n"
    printf "  Architecture : %s\n" "$mode_str"
    printf "  Grid & Pupil : %sx%s pix (pup_%s.fits: %s)\n" \
        "$size" "$size" "$size" \
        "$([ -f "pup_${size}.fits" ] && echo "present" || echo "MISSING")"
    printf "  Bandpass     : %s nm, %s%% bandwidth (%s channels), %s FPM rings\n" \
        "$lam" "$bw" "$nch" "$nbrings"

    local cdir=""
    if [ -L "piaacmcconf_i000" ] && [ -d "piaacmcconf_i000" ]; then
        cdir=$(readlink "piaacmcconf_i000")
    elif [ -d "piaacmcconf_i000" ]; then
        cdir="piaacmcconf_i000"
    elif [ -f "log/dirname.txt" ]; then
        cdir=$(cat "log/dirname.txt")
    else
        local first_dir
        first_dir=$(compgen -G "piaacmcconf_*" | head -n 1 || true)
        [ -n "$first_dir" ] && [ -d "$first_dir" ] && cdir="$first_dir"
    fi

    if [ -z "$cdir" ] || [ ! -d "$cdir" ]; then
        printf "\n${C_BOLD}Pipeline Status:${C_RESET} Not started yet.\n"
        return 0
    fi

    printf "  Active Dir   : %s\n\n" "$cdir"
    printf "${C_BOLD}Monochromatic Steps (000..017):${C_RESET}\n  "
    local done_cnt=0
    for s in $(seq -f "%03g" 0 17); do
        if [ -f "${cdir}/step${s}.txt" ]; then
            printf "${C_GREEN}%s${C_RESET} " "$s"
            done_cnt=$((done_cnt + 1))
        else
            printf "%s " "$s"
        fi
        [ "$s" = "008" ] && printf "\n  "
    done
    printf "\n  Completed: %d / 18 steps\n" "$done_cnt"

    printf "\n${C_BOLD}Polychromatic FPM Optimization:${C_RESET}\n"
    local fpmresp
    fpmresp=$(compgen -G "${cdir}/FPMresp*.fits" | grep -v "thread" | head -n 1 || true)
    if [ -n "$fpmresp" ]; then
        log_ok "FPM zone response matrix: ${fpmresp}"
    else
        printf "  [    ] FPM zone response matrix not yet computed\n"
    fi

    local bestval
    bestval=$(compgen -G "${cdir}/mode13*.bestval.txt" | head -n 1 || true)
    if [ -n "$bestval" ]; then
        log_ok "Best multi-zone metric ($(basename "$bestval")): $(cat "$bestval")"
    else
        printf "  [    ] Multi-zone sag optimization not yet run\n"
    fi

    if [ -f "fpmout.txt" ] && [ -f "saglevels.dat" ]; then
        local nlev
        nlev=$(wc -l < "saglevels.dat" | tr -d '[:space:]')
        log_ok "Quantized FPM table: fpmout.txt (${nlev} discrete sag levels)"
    fi

    for ev in eval0 eval1 eval2; do
        local evdir=""
        [ -d "${ev}" ] && evdir="${ev}"
        [ -z "$evdir" ] && [ -d "${cdir}/${ev}" ] && evdir="${cdir}/${ev}"
        if [ -n "$evdir" ]; then
            printf "\n${C_BOLD}Evaluation (${evdir}):${C_RESET}\n"
            for cf in "${evdir}"/ContrastVal*.txt; do
                [ -f "$cf" ] || continue
                local cval_line
                cval_line=$(grep -v '^#' "$cf" | head -n 1 || true)
                printf "  %-28s : %s\n" "$(basename "$cf")" "$cval_line"
            done
        fi
    done
}

cmd_run() {
    local step="18"
    local jobs=""
    local search_time=""
    local save_flag=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --mono)
                step="18"
                shift
                ;;
            --poly)
                step="200"
                shift
                ;;
            -m|--to-step)
                step="$2"
                shift 2
                ;;
            -j|--jobs)
                jobs="$2"
                shift 2
                ;;
            -t|--search-time)
                search_time="$2"
                shift 2
                ;;
            -S|--save-steps)
                save_flag="-S"
                shift
                ;;
            -h|--help)
                cat <<EOF
${C_BOLD}USAGE:${C_RESET} coffee-piaacmc run [options]

${C_BOLD}OPTIONS:${C_RESET}
      --mono               Run full idealized monochromatic design (steps 1..18)
      --poly               Run monochromatic + polychromatic FPM design (-m 200)
  -m, --to-step <N>        Stop after monochromatic step N (1..18) or mode 200
  -j, --jobs <J>           Parallel workers for step 100 FPM response calibration
  -t, --search-time <SEC>  Time budget in seconds for Mode 13 FPM sag search
  -S, --save-steps         Snapshot workspace directory after each top-level step
EOF
                return 0
                ;;
            *)
                log_err "Unknown run option: $1"
                return 1
                ;;
        esac
    done

    validate_config 1
    if [ -n "$jobs" ]; then
        write_conf_key "NBthreads" "$jobs"
        export COFFEE_JOBS="$jobs"
    fi
    if [ -n "$search_time" ]; then
        write_conf_key "searchtime" "$search_time"
        export COFFEE_SEARCHTIME="$search_time"
    fi
    write_piaacmc_conf_from_dir

    log_info "Running PIAACMC design pipeline (target step=${step})..."
    if [ -n "$save_flag" ]; then
        coffee-runPIAACMCdesign "$save_flag" -m "$step"
    else
        coffee-runPIAACMCdesign -m "$step"
    fi
}

cmd_eval() {
    local mode="400"
    while [ $# -gt 0 ]; do
        case "$1" in
            --psf)
                mode="300"
                shift
                ;;
            -l|--level)
                case "$2" in
                    0) mode="400" ;;
                    1) mode="401" ;;
                    2) mode="402" ;;
                    *)
                        log_err "Invalid evaluation level '$2' (expected 0, 1, or 2)."
                        return 1
                        ;;
                esac
                shift 2
                ;;
            -h|--help)
                cat <<EOF
${C_BOLD}USAGE:${C_RESET} coffee-piaacmc eval [--psf | --level 0|1|2]

${C_BOLD}OPTIONS:${C_RESET}
      --psf          Compute polychromatic on-axis PSF only (-m 300)
  -l, --level <0..2> Polychromatic contrast & transmission evaluation (default: 0)
                       0: Point source + 1 mas resolved star + transmission curve
                       1: Level 0 + stellar angular size sweep (0.1..4 mas)
                       2: Level 1 + pointing jitter sensitivity sweep
EOF
                return 0
                ;;
            *)
                log_err "Unknown eval option: $1"
                return 1
                ;;
        esac
    done

    validate_config 1
    log_info "Running PIAACMC evaluation (mode=${mode})..."
    coffee-runPIAACMCdesign -m "$mode"
    cmd_status
}

cmd_quantize() {
    if [ $# -lt 1 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
        cat <<EOF
${C_BOLD}USAGE:${C_RESET} coffee-piaacmc quantize <NBexp>

Quantize continuous multi-zone FPM sags (.best.fits) to 2^NBexp discrete levels.
EOF
        [ $# -lt 1 ] && return 1 || return 0
    fi
    validate_config 1
    coffee-runPIAACMCdesign -q "$1"
}

cmd_clean() {
    local all=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -a|--all)
                all=1
                shift
                ;;
            -h|--help)
                cat <<EOF
${C_BOLD}USAGE:${C_RESET} coffee-piaacmc clean [--all]

  (default)  Remove simulation outputs while keeping pupil, conf/, and piaacmc.conf
  -a, --all  Remove all simulation outputs, pupil FITS, conf/, and piaacmc.conf
EOF
                return 0
                ;;
            *)
                log_err "Unknown clean option: $1"
                return 1
                ;;
        esac
    done

    if [ "$all" -eq 1 ]; then
        coffee-runclean -l 0
        log_ok "Cleaned all simulation outputs and configuration files."
    else
        coffee-runclean -l 1
        log_ok "Cleaned simulation outputs (preserved pupil and configuration)."
    fi
}

main() {
    if [ $# -eq 0 ]; then
        print_usage
        exit 0
    fi

    local cmd="$1"
    shift
    case "$cmd" in
        init)     cmd_init "$@" ;;
        config)   cmd_config "$@" ;;
        status)   cmd_status "$@" ;;
        run)      cmd_run "$@" ;;
        eval)     cmd_eval "$@" ;;
        quantize) cmd_quantize "$@" ;;
        clean)    cmd_clean "$@" ;;
        -h|--help|help)
            print_usage
            ;;
        *)
            log_err "Unknown command '${cmd}'."
            print_usage
            exit 1
            ;;
    esac
}

main "$@"
